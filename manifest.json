{
  "manifest_version": 3,
  "name": "FB Feed Cleaner",
  "version": "1.4.11",
  "description": "Hides the posts Facebook injects into your news feed: suggested posts marked \"Follow\", suggested groups, and \"Sponsored\" ads.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FB Feed Cleaner"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
